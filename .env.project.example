# .env.project.example — template for the file generated by scripts/setup-project.sh
#
# Copy this to .env.project and fill in real values, OR run setup-project.sh
# to generate it automatically.
#
# None of these values are secrets — they are GitHub node IDs and option IDs
# that are safe to commit.

